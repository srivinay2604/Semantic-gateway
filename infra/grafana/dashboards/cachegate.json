        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(cg_cache_lookup_duration_seconds_bucket[1m])))",
          "legendFormat": "p95 {{tier}} lookup",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, tier) (rate(cg_cache_lookup_duration_seconds_bucket[1m])))",
          "legendFormat": "p50 {{tier}} lookup",
          "refId": "B"
        }
      ],
      "title": "Cache Lookup Duration (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
